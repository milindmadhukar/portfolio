[submodule "website/blog-content"]
	path = website/blog-content
	# Relative on purpose, and it is what makes the private blog clone anywhere
	# without storing a credential.
	#
	# Git resolves a relative submodule URL against the superproject's own remote,
	# carrying that remote's credentials with it. So whoever cloned the parent can
	# clone this, using the access they already had:
	#   - Dokploy clones as https://oauth2:<token>@github.com/.../portfolio.git,
	#     so this resolves to the same host and token. An absolute URL got no
	#     credential at all, which is why it failed.
	#   - actions/checkout authenticates https://github.com/ with an extraheader,
	#     which likewise applies here.
	#   - a local clone just reuses whatever credentials you already use.
	#
	# The alternative was a deploy key stored in Dokploy - but that instance is
	# shared, so any key there is readable by its other users.
	url = ../blog.git
	branch = main
