---
import TerminalPrompt from "./TerminalPrompt.astro";
import TerminalCommand from "./TerminalCommand.astro";
import TerminalRail from "./TerminalRail.astro";
import FastfetchOutput from "./outputs/FastfetchOutput.astro";
import WhoamiOutput from "./outputs/WhoamiOutput.astro";
import ProjectsOutput from "./outputs/ProjectsOutput.astro";
import { TERMINAL_CONFIG } from "../lib/constants";
import { TERMINAL_STATES, stateIndexForKey } from "../lib/terminal-states";

interface Props {
    /** Which state to open on. Deep links land here already rendered. */
    initialKey?: string;
}

const { initialKey } = Astro.props;
const initialIndex = stateIndexForKey(initialKey);

// Ordered list of terminal "states". Scrolling steps forward/backward through
// these; each renders a typed command followed by its output. The sequence
// itself lives in terminal-states.ts (the rail and the [cmd] route read the
// same list); only the output component is bound here, since those are
// component imports. The controller below is fully generic over this array.
const OUTPUTS: Record<string, any> = {
    fastfetch: FastfetchOutput,
    whoami: WhoamiOutput,
    projects: ProjectsOutput,
};

const states = TERMINAL_STATES.map((state) => ({
    ...state,
    Output: OUTPUTS[state.key],
}));
---

<!--
    Full-page section controller (see <script> below).
    Native scrolling is disabled — each wheel / key / touch gesture advances the
    terminal by exactly one section. `currentIndex` is the single source of truth,
    so the visible state can never desync from a scroll position.
-->
<div
    class="h-screen w-full overflow-hidden relative"
    id="desktop-scroll-container"
>
    <!-- Full-viewport visual layer: one section fills the whole screen. -->
    <div
        class="absolute inset-0 h-screen w-full z-20 flex flex-col pt-12 pointer-events-none p-8"
    >
        <div
            id="terminal-content"
            class="font-mono text-base md:text-base lg:text-lg xl:text-xl leading-tight w-fit pointer-events-auto"
        >
            {
                states.map((state, index) => {
                    const Output = state.Output;
                    return (
                        <div
                            id={`state-${state.key}`}
                            class={`terminal-state transition-opacity duration-300 ${index !== initialIndex ? "hidden" : ""}`}
                        >
                            <div class="mb-4">
                                <TerminalPrompt
                                    user={TERMINAL_CONFIG.user}
                                    host={TERMINAL_CONFIG.host}
                                >
                                    <TerminalCommand
                                        command={state.command}
                                        id={`cmd-${state.key}`}
                                        triggerEventName={`trigger-${state.key}`}
                                        onCompleteEventName={`complete-${state.key}`}
                                        startDelay={state.startDelay}
                                    />
                                </TerminalPrompt>
                            </div>
                            <div
                                id={`output-${state.key}`}
                                class="output-container hidden"
                            >
                                <Output />
                            </div>

                            {/* Trailing "clear" prompt — typed when leaving this state (either direction). */}
                            <div
                                id={`clear-${state.key}`}
                                class="interaction-layer mt-2 py-1 hidden"
                            >
                                <TerminalPrompt
                                    user={TERMINAL_CONFIG.user}
                                    host={TERMINAL_CONFIG.host}
                                >
                                    <TerminalCommand
                                        command="clear"
                                        id={`cmd-clear-${state.key}`}
                                        triggerEventName={`trigger-clear-${state.key}`}
                                        onCompleteEventName={`complete-clear-${state.key}`}
                                        typingSpeed={50}
                                    />
                                </TerminalPrompt>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>

    <!-- Jump navigation. Desktop-only; renders nothing below lg. -->
    <TerminalRail states={TERMINAL_STATES} initialIndex={initialIndex} />

    <!-- Scroll Indicator -->
    <div
        id="scroll-indicator"
        class="fixed bottom-12 left-1/2 -translate-x-1/2 z-50 transition-opacity duration-300 pointer-events-none hidden"
    >
        <div
            class="flex flex-col items-center gap-2 animate-bounce text-ctp-peach drop-shadow-md"
        >
            <div class="flex flex-col items-center">
                <span class="text-xs font-bold font-mono tracking-widest mb-1"
                    >SCROLL OR PRESS</span
                >
                <div class="flex gap-2 text-xl">
                    <i class="nf nf-fa-angle_up"></i>
                    <i class="nf nf-fa-angle_down"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<script
    define:vars={{
        stateKeys: states.map((s) => s.key),
        statePaths: states.map((s) => s.path),
        initialIndex,
    }}
>
    const lastIndex = stateKeys.length - 1;

    // Controller state — `currentIndex` is the single source of truth for which
    // section is visible. There is no native scroll position to fall out of sync
    // with it, so the old "stuck between sections" desync is impossible.
    let currentIndex = initialIndex;
    let isAnimating = false;
    let pendingTarget = initialIndex;
    // A navigation intent (+1 / -1) requested while a transition is mid-flight.
    // The latest one wins, so reversing direction mid-animation is honoured.
    let queuedDir = 0;
    // An absolute target requested by the rail mid-flight. Kept separate from
    // queuedDir and drained first: a click names a destination, so it shouldn't
    // be reinterpreted as a relative step once the transition lands.
    let queuedIndex = null;

    const container = document.getElementById("desktop-scroll-container");
    const scrollIndicator = document.getElementById("scroll-indicator");

    // Element lookups
    const stateEl = (k) => document.getElementById(`state-${k}`);
    const outputEl = (k) => document.getElementById(`output-${k}`);
    const clearEl = (k) => document.getElementById(`clear-${k}`);

    // Uncover an output block with a soft edge sweeping down from the command
    // line. The class is stripped once the sweep lands: a live mask clips
    // everything to the container's border box, which would cut the glow off
    // the project rows, and re-resolves against the block height whenever the
    // Discord island changes size after hydration.
    function revealOutput(el) {
        el.classList.remove("hidden");
        el.classList.add("reveal-sweep");
        el.addEventListener("animationend", function done(e) {
            if (e.animationName !== "reveal-sweep") return;
            el.classList.remove("reveal-sweep");
            el.removeEventListener("animationend", done);
        });
    }

    // Reset a "clear" prompt back to its empty, cursor-visible waiting state.
    function resetClear(k) {
        const text = document.getElementById(`cmd-clear-${k}-text`);
        if (text) text.textContent = "";
        const cursor = document.getElementById(`cmd-clear-${k}-cursor`);
        if (cursor) cursor.style.display = "inline-block";
    }

    function updateIndicator() {
        if (!scrollIndicator) return;
        // Reveal on first paint; hide once there's nothing below to scroll to.
        scrollIndicator.classList.remove("hidden");
        if (currentIndex >= lastIndex) {
            scrollIndicator.classList.add("opacity-0");
        } else {
            scrollIndicator.classList.remove("opacity-0");
        }
    }

    // Keep the address bar on the visible command so any state can be shared.
    // replaceState, not pushState: scrolling is a passive gesture, and stacking
    // a history entry per step would mean three Back presses to leave the site.
    // The first state keeps the bare "/" — the homepage is never rewritten to a
    // slug, though /fastfetch is still accepted on the way in.
    function syncUrl(index) {
        const path = statePaths[index];
        if (!path || window.location.pathname === path) return;
        history.replaceState(null, "", path + window.location.search);
    }

    // Kick off whichever command this URL asked for. A deep link is already
    // rendered as the visible state server-side, so nothing else ever paints.
    setTimeout(() => {
        window.dispatchEvent(new Event(`trigger-${stateKeys[initialIndex]}`));
    }, 100);

    // Per-state handlers: command completion + clear completion.
    stateKeys.forEach((k, idx) => {
        // Command finished typing -> reveal output, park a waiting "clear" prompt.
        window.addEventListener(`complete-${k}`, () => {
            const out = outputEl(k);
            if (out) revealOutput(out);

            const cmdCursor = document.getElementById(`cmd-${k}-cursor`);
            if (cmdCursor) cmdCursor.style.display = "none";

            const clear = clearEl(k);
            if (clear) {
                clear.classList.remove("hidden");
                resetClear(k);
            }

            currentIndex = idx;
            isAnimating = false;
            updateIndicator();
            syncUrl(idx);

            // The rail's active dot follows this, not the click — a click is a
            // request, and only this handler knows the state actually landed.
            window.dispatchEvent(
                new CustomEvent("terminal-state-change", {
                    detail: { index: idx, key: k },
                }),
            );

            // Apply any navigation that arrived while we were animating. An
            // absolute target (rail click) wins over a relative one (gesture).
            if (queuedIndex !== null) {
                const target = queuedIndex;
                queuedIndex = null;
                queuedDir = 0;
                startTransition(target);
            } else if (queuedDir !== 0) {
                const dir = queuedDir;
                queuedDir = 0;
                navigate(dir);
            }
        });

        // "clear" finished typing -> swap to the pending target and type its command.
        window.addEventListener(`complete-clear-${k}`, () => {
            const targetKey = stateKeys[pendingTarget];

            // Hide the current state entirely (its output + clear go with it).
            const current = stateEl(k);
            if (current) current.classList.add("hidden");

            // Reveal the target fresh and re-run its typing animation.
            const target = stateEl(targetKey);
            if (target) target.classList.remove("hidden");
            const targetOut = outputEl(targetKey);
            if (targetOut) {
                targetOut.classList.add("hidden");
                // Clear a half-finished sweep so re-entering this state starts one.
                targetOut.classList.remove("reveal-sweep");
            }
            const targetClear = clearEl(targetKey);
            if (targetClear) targetClear.classList.add("hidden");

            window.dispatchEvent(new Event(`trigger-${targetKey}`));
        });
    });

    // Begin a transition from the current state to a target index.
    function startTransition(targetIndex) {
        if (isAnimating || targetIndex === currentIndex) return;
        isAnimating = true;
        pendingTarget = targetIndex;

        const k = stateKeys[currentIndex];
        const clear = clearEl(k);
        if (clear) {
            clear.classList.remove("hidden");
            resetClear(k);
            window.dispatchEvent(new Event(`trigger-clear-${k}`));
        }
    }

    // Central navigation entry point. `dir` is +1 (down) or -1 (up).
    // While a transition is animating, the intent is queued (latest wins) so a
    // reversal mid-flight is respected instead of dropped.
    function navigate(dir) {
        if (dir === 0) return;
        if (isAnimating) {
            queuedDir = dir;
            return;
        }
        const target = Math.min(lastIndex, Math.max(0, currentIndex + dir));
        if (target === currentIndex) return; // clamped at an edge — no-op
        startTransition(target);
    }

    // --- Rail: jump straight to any state ---------------------------------------
    // startTransition already accepts an arbitrary index and routes through the
    // typed `clear`, so a jump looks exactly like a scroll step — the same clear,
    // then the target's command typed out fresh.
    window.addEventListener("terminal-goto", (e) => {
        const index = e.detail?.index;
        if (typeof index !== "number" || index < 0 || index > lastIndex) return;
        if (isAnimating) {
            queuedIndex = index;
            return;
        }
        startTransition(index);
    });

    // --- Wheel: one gesture = exactly one section ------------------------------
    // A continuous scroll (and trackpad inertia) fires a burst of wheel events.
    // We act on the first event of a burst, then stay locked until the wheel has
    // been idle for a moment — so the length/speed of the scroll is irrelevant.
    const WHEEL_IDLE_MS = 180;
    const WHEEL_MIN_DELTA = 4;
    let wheelLocked = false;
    let wheelIdleTimer = null;

    if (container) {
        container.addEventListener(
            "wheel",
            (e) => {
                // Nothing scrolls natively; block rubber-band / parent scroll.
                e.preventDefault();

                // Every event (including inertial ones) postpones the unlock,
                // so one physical gesture stays collapsed into a single step.
                clearTimeout(wheelIdleTimer);
                wheelIdleTimer = setTimeout(() => {
                    wheelLocked = false;
                }, WHEEL_IDLE_MS);

                if (wheelLocked) return;
                if (Math.abs(e.deltaY) < WHEEL_MIN_DELTA) return;

                wheelLocked = true;
                navigate(e.deltaY > 0 ? 1 : -1);
            },
            { passive: false },
        );
    }

    // --- Keyboard --------------------------------------------------------------
    window.addEventListener("keydown", (e) => {
        if (!container || container.offsetParent === null) return;

        // Space is the one key a focused rail button already acts on, so it
        // would otherwise both activate the button and advance a state. Scoped
        // to Space deliberately: arrows and PageUp/PageDown aren't button
        // activation keys, and clicking a dot leaves it focused — a broader
        // guard would kill keyboard navigation for the rest of the visit.
        if (e.key === " " && document.activeElement?.closest("#terminal-rail")) {
            return;
        }

        if (e.key === "ArrowDown" || e.key === "PageDown" || e.key === " ") {
            e.preventDefault();
            navigate(1);
        } else if (e.key === "ArrowUp" || e.key === "PageUp") {
            e.preventDefault();
            navigate(-1);
        }
    });

    // --- Touch: one swipe = one section ---------------------------------------
    const TOUCH_THRESHOLD = 40;
    let touchStartY = null;

    if (container) {
        container.addEventListener(
            "touchstart",
            (e) => {
                touchStartY = e.touches[0].clientY;
            },
            { passive: true },
        );
        container.addEventListener(
            "touchmove",
            (e) => {
                e.preventDefault(); // no native panning
            },
            { passive: false },
        );
        container.addEventListener("touchend", (e) => {
            if (touchStartY === null) return;
            const dy = touchStartY - e.changedTouches[0].clientY;
            touchStartY = null;
            if (Math.abs(dy) > TOUCH_THRESHOLD) navigate(dy > 0 ? 1 : -1);
        });
    }
</script>
