---
import TerminalPrompt from "./TerminalPrompt.astro";
import TerminalCommand from "./TerminalCommand.astro";
import FastfetchOutput from "./outputs/FastfetchOutput.astro";
import WhoamiOutput from "./outputs/WhoamiOutput.astro";
import ProjectsOutput from "./outputs/ProjectsOutput.astro";
import { TERMINAL_CONFIG } from "../lib/constants";
import { TERMINAL_STATES, stateIndexForKey } from "../lib/terminal-states";

interface Props {
    /** Which command a shared link asked for. Everything above it is pre-filled. */
    initialKey?: string;
}

const { initialKey } = Astro.props;
const initialIndex = stateIndexForKey(initialKey);

// Same sequence as the desktop terminal (see terminal-states.ts) — only the
// presentation differs: mobile scrolls and reveals each command in turn rather
// than swapping one full-screen state for the next.
const OUTPUTS: Record<string, any> = {
    fastfetch: FastfetchOutput,
    whoami: WhoamiOutput,
    projects: ProjectsOutput,
};

const commands = TERMINAL_STATES.map((state) => ({
    id: `mobile-${state.key}`,
    command: state.command,
    output: OUTPUTS[state.key],
    triggerEvent: `trigger-mobile-${state.key}`,
}));
---

<div class="flex flex-col gap-16 pb-20">
    {
        commands.map((cmd, index) => (
            <div
                id={`section-${cmd.id}`}
                class={`mobile-command-section opacity-0 transition-opacity duration-500 ${index > initialIndex ? "hidden" : ""}`}
                data-trigger-event={cmd.triggerEvent}
                data-next-section={
                    index < commands.length - 1
                        ? `section-${commands[index + 1].id}`
                        : undefined
                }
            >
                <div class="mb-4">
                    <TerminalPrompt
                        user={TERMINAL_CONFIG.user}
                        host={TERMINAL_CONFIG.host}
                    >
                        <TerminalCommand
                            command={cmd.command}
                            id={cmd.id}
                            triggerEventName={cmd.triggerEvent}
                            onCompleteEventName={`${cmd.id}-complete`}
                        />
                    </TerminalPrompt>
                </div>
                <div
                    id={`${cmd.id}-output`}
                    class="mobile-output hidden"
                >
                    <cmd.output />
                </div>
            </div>
        ))
    }
</div>

<script
    define:vars={{
        commandIds: commands.map((c) => c.id),
        commandTexts: commands.map((c) => c.command),
        initialIndex,
    }}
>
    // Intersection Observer to trigger animations
    const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.1, // Trigger slightly earlier/easier
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const element = entry.target;
                const triggerEvent = element.dataset.triggerEvent;

                if (triggerEvent && !element.classList.contains("triggered")) {
                    // Reveal the section
                    element.classList.remove("opacity-0");
                    element.classList.add("triggered");

                    // Trigger the typing animation
                    window.dispatchEvent(new Event(triggerEvent));
                }
            }
        });
    }, observerOptions);

    // Initial observation (only the visible ones)
    // We'll use a MutationObserver or just re-observe when we show new ones?
    // Actually, we can just observe all of them. Hidden elements won't intersect.
    // Wait, intersection observer on hidden (display: none) elements doesn't work.
    // That's fine. We observe them. When we remove "hidden", if they are in viewport, they will intersect.

    document.querySelectorAll(".mobile-command-section").forEach((section) => {
        observer.observe(section);
    });

    // Listen for completion to show output and reveal next
    commandIds.forEach((id) => {
        window.addEventListener(`${id}-complete`, () => {
            const output = document.getElementById(`${id}-output`);
            if (output) {
                // Same downward sweep as desktop; the class comes back off once
                // it lands so the mask stops clipping the project-row glow.
                output.classList.remove("hidden");
                output.classList.add("reveal-sweep");
                output.addEventListener("animationend", function done(e) {
                    if (e.animationName !== "reveal-sweep") return;
                    output.classList.remove("reveal-sweep");
                    output.removeEventListener("animationend", done);
                });
            }
            // Hide cursor
            const cursor = document.getElementById(`${id}-cursor`);
            if (cursor) cursor.style.display = "none";

            // Reveal Next Section
            const currentSection = document.getElementById(`section-${id}`);
            if (currentSection && currentSection.dataset.nextSection) {
                const nextSectionId = currentSection.dataset.nextSection;
                const nextSection = document.getElementById(nextSectionId);
                if (nextSection) {
                    nextSection.classList.remove("hidden");
                    // Observer is already watching it, so if it's in viewport, it will trigger.
                }
            }
        });
    });

    // --- Deep links ------------------------------------------------------------
    // A shared /projects link has to land on projects, but the cascade only
    // un-hides a section once the one above it finishes typing. So we fast-
    // forward everything above the target — filling in the typed text and
    // revealing the output with no animation — then scroll to the target and
    // let the observer play its typing and sweep as usual. That arrival is the
    // good part; replaying two commands the visitor didn't ask for is not.
    if (initialIndex > 0) {
        for (let i = 0; i < initialIndex; i++) {
            const id = commandIds[i];

            const text = document.getElementById(`${id}-text`);
            if (text) text.textContent = commandTexts[i];

            const cursor = document.getElementById(`${id}-cursor`);
            if (cursor) cursor.style.display = "none";

            const output = document.getElementById(`${id}-output`);
            if (output) output.classList.remove("hidden");

            // `triggered` is the observer's fire-once guard — setting it here is
            // what stops these sections from typing themselves out again when
            // the visitor scrolls back up.
            const section = document.getElementById(`section-${id}`);
            if (section) {
                section.classList.remove("opacity-0");
                section.classList.add("triggered");
            }
        }

        const target = document.getElementById(
            `section-${commandIds[initialIndex]}`,
        );

        if (target) {
            // Clear the theme switcher, which is fixed at the top of the
            // viewport — scrolling the section flush to y=0 would park the
            // prompt line right back underneath it.
            const TOP_GAP = 72;

            let cancelled = false;
            const cancel = () => {
                cancelled = true;
            };
            // The moment the visitor scrolls themselves, stop re-aligning —
            // yanking the page back under them would be worse than landing
            // slightly off.
            const opts = { once: true, passive: true };
            window.addEventListener("wheel", cancel, opts);
            window.addEventListener("touchstart", cancel, opts);
            window.addEventListener("keydown", cancel, { once: true });

            function align() {
                if (cancelled) return;
                const top =
                    target.getBoundingClientRect().top +
                    window.scrollY -
                    TOP_GAP;
                window.scrollTo({ top: Math.max(0, top) });
            }

            // Everything above the target keeps growing after first paint — the
            // Discord island hydrates, the web fonts swap in — so a single
            // scroll lands hundreds of pixels short. Re-align until it settles.
            requestAnimationFrame(align);
            window.addEventListener("load", align);
            const settle = setInterval(align, 150);
            setTimeout(() => clearInterval(settle), 1500);
        }
    }
</script>
