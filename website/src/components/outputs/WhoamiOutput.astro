---
import { personalInfo } from "../../lib/constants";

// One line per line, not paragraphs — the bio is authored broken up.
const bioLines = personalInfo.bio.long.split("\n");
---

<div class="max-w-4xl text-ctp-text leading-snug">
    <div class="mb-3">
        <span class="text-ctp-subtext0">hi, i am </span><span
            class="animate-name-glow rounded px-1.5 font-bold text-ctp-mauve"
            >{personalInfo.name.toLowerCase()}</span
        >
    </div>

    <div class="text-ctp-subtext0 flex flex-col">
        {
            bioLines.map((line) =>
                line.trim() === "" ? <div class="h-3" /> : <p>{line}</p>,
            )
        }
    </div>

    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
        <a
            href={personalInfo.links.plusxhub}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ctp-blue hover:underline"
        >
            <i class="nf nf-fa-instagram"></i> plusxhub, my MG community
        </a>
        <a
            href={personalInfo.links.garrixPlaylist}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ctp-blue hover:underline"
        >
            <i class="nf nf-fa-spotify"></i> my martin garrix playlist
        </a>
    </div>
</div>
