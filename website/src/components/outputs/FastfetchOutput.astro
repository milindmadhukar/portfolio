---
import { fetchGithubStats } from "../../lib/github";
import { formatTimeAgo } from "../../lib/date";
import DiscordStatus from "../DiscordStatus";
import SocialIcons from "../SocialIcons.astro";
import TerminalRule from "../TerminalRule.astro";
import { experience, education, DISCORD_ID, EXPERIENCE_START_DATE, BIRTH_DATE } from "../../lib/constants";
import { getBlogPosts } from "../../lib/blog";
import { calculateExperience, formatUptime, pluralize } from "../../lib/utils";
import { getPresence } from "../../lib/lanyard-server";

const githubStats = await fetchGithubStats();
const experienceLabel = calculateExperience(new Date(EXPERIENCE_START_DATE));
const posts = getBlogPosts();
const latestPost = posts.length > 0 ? posts[0] : null;

// Rendered from the socket the server already holds open, so the Discord /
// Spotify rows are in the initial HTML rather than arriving after hydration.
const presence = await getPresence();

// Likewise the uptime: the per-second ticker in index.astro takes over from
// here, but the first paint shows the real elapsed time, not "Loading...".
const uptime = formatUptime(new Date(BIRTH_DATE));
---

<div>
    <div
        class="flex flex-col lg:flex-row gap-10 items-center lg:items-start w-fit"
    >
        <div class="select-none text-ctp-blue font-bold">
            <pre
                class="hidden lg:block">
   ,=====================.
   |MILIND'S  LAB  /6000/|
   |.-------------------.|
   ||[ _ o     . .  _ ]_||
   |`-------------------'|
   ||                   ||
   |`-------------------'|
   ||                   ||
   |`-------------------'|
   ||                   ||
   |`-----------------_-'|
   ||[=========]| o  (@) |
   |`---------=='/u\ --- |
   |------_--------------|
   | (/) (_)           []|
   |---==--==----------==|
   |||||||||||||||||||||||
   |||||||||||||||||||||||
   |||||||||||||||||||||||
   |||||||||||||||||||||||
   |||||||||||||||||||||||
   |||||||||||||||||||||||
   ||||||||||||||||||+×|||
   |||||||||||||||||||||||
   |=====================|
  .'                     `.
 """""""""""""""""""""""""""
          </pre>
            <pre
                class="block lg:hidden">
   +--------------+
   |.------------.|
   ||            ||
   ||   HELLO    ||
   ||    WORLD   ||
   ||            ||
   |+------------+|
   +-..--------..-+
   .--------------.
  / /============\ \
 / /==============\ \
/____________________\
\____________________/
          </pre>
        </div>

        <!--
            The rules size themselves to this column, so the column's width is
            what makes them look right: it hugs its widest line, capped at 64ch
            (a few cells above the natural longest row, the GitHub stats one).
            The cap only engages for outliers like a very long song title,
            which then wraps onto a second, hanging-indented line instead of
            re-widthing the whole block mid-track.
        -->
        <div class="term-info flex flex-col gap-[2px] min-w-0 max-w-full lg:max-w-[64ch]">
            <div class="mb-2">
                <span class="text-ctp-red">portfolio</span><span
                    class="text-ctp-overlay2">@</span
                ><span class="text-ctp-teal">milind.dev</span>
            </div>
            <TerminalRule />
            <div class="term-row">
                <a
                    href={experience[0].website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group"
                >
                    <span class="text-ctp-blue"
                        ><i class="nf nf-fa-building"></i> Work</span
                    >
                    <span> : </span><span
                        class="text-ctp-text group-hover:underline decoration-ctp-teal underline-offset-4 group-hover:text-ctp-teal transition-colors"
                        >{experience[0].company}</span
                    >
                </a>
            </div>
            <div class="term-row">
                <span class="text-ctp-blue"
                    ><i class="nf nf-fa-id_badge"></i> Role</span
                >
                <span> : {experience[0].title}</span>
            </div>
            <div class="term-row">
                <span class="text-ctp-blue"
                    ><i class="nf nf-md-school"></i> Education</span
                >
                <span> : {education[0].institution}</span>
            </div>
            <div class="term-row">
                <span class="text-ctp-blue"
                    ><i class="nf nf-md-briefcase"></i> Experience</span
                >
                <span> : {experienceLabel}</span>
            </div>
            <div class="term-row">
                <span class="text-ctp-blue"
                    ><i class="nf nf-md-clock"></i> Uptime</span
                >
                <span> : </span><span class="uptime">{uptime}</span>
            </div>
            <div class="term-row">
                <span class="text-ctp-blue"
                    ><i class="nf nf-linux-archlinux"></i> OS</span
                >
                <span> : arch btw</span>
            </div>
            {
                posts.length > 0 && (
                    <div>
                        <a
                            href="/blog"
                            class="group flex items-center gap-2 animate-gold-pulse -ml-2 px-2 rounded w-fit"
                        >
                            <span class="text-ctp-yellow font-bold group-hover:text-ctp-teal transition-colors">
                                <i class="nf nf-md-file_document" /> Blog
                            </span>
                            <span class="text-ctp-overlay2">::</span>
                            <span class="text-ctp-text group-hover:underline decoration-ctp-yellow underline-offset-4">
                                {pluralize(posts.length, "article")}
                            </span>
                            <span class="text-xs text-ctp-overlay0 opacity-0 group-hover:opacity-100 transition-opacity">
                                [READ]
                            </span>
                        </a>
                    </div>
                )
            }
            {
                latestPost && (
                    <div class="term-row">
                        <span class="text-ctp-mauve">
                            <i class="nf nf-fa-pen_nib" /> Latest Post
                        </span>
                        <span> : </span>
                        <a
                            href={latestPost.url}
                            class="text-ctp-text hover:underline hover:text-ctp-teal transition-colors"
                        >
                            {latestPost.title}
                        </a>
                    </div>
                )
            }

            {
                githubStats && (
                    <>
                        <TerminalRule />
                        <div class="term-row">
                            <i class="nf nf-fa-github" /> Github Stats
                            <span> : </span>
                            <span>
                                Repos: {githubStats.repos} | Followers:{" "}
                                {githubStats.followers} | Following:{" "}
                                {githubStats.following}
                            </span>
                        </div>
                        {githubStats.lastPush && (
                            <div class="term-row">
                                <span class="text-ctp-mauve">
                                    <i class="nf nf-oct-git_commit" /> Last
                                    Commit
                                </span>
                                <span> : </span>
                                <a
                                    href={
                                        "https://github.com/" +
                                        githubStats.lastPush.repo
                                    }
                                    target="_blank"
                                    class="text-ctp-text hover:underline"
                                >
                                    <span>
                                        {githubStats.lastPush.repo} -{" "}
                                        {formatTimeAgo(githubStats.lastPush.at)}
                                    </span>
                                </a>
                            </div>
                        )}
                    </>
                )
            }

            <div>
                <DiscordStatus
                    client:load
                    userId={DISCORD_ID}
                    socketUrl={process.env.LANYARD_SOCKET_URL || ""}
                    initialData={presence}
                />
            </div>
            <TerminalRule />
            <div class="mt-4 mb-2">
                <SocialIcons
                    size="w-10 h-10 lg:w-10 lg:h-10"
                    iconSize="text-lg lg:text-lg"
                    gap="gap-3"
                    showRss={false}
                />
            </div>
        </div>
    </div>
</div>
