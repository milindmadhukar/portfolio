---
// A shareable URL per terminal command: /whoami, /projects (and /fastfetch,
// which mirrors the homepage). The page renders the requested state directly,
// so a deep link never flashes fastfetch on its way over.
//
// Single-segment only, and every unknown value 404s — /blog, /sitemap.xml and
// /api/* all match more specific routes and never reach here.
import TerminalPage from "../components/TerminalPage.astro";
import { pageTitle, personalInfo, projects } from "../lib/constants";
import { TERMINAL_STATES, stateIndexForSlug } from "../lib/terminal-states";

export const prerender = false;

const index = stateIndexForSlug(Astro.params.cmd);

if (index === -1) {
    return new Response(null, { status: 404 });
}

const state = TERMINAL_STATES[index];

// Per-command metadata, so the three URLs don't all share one title in search
// results and link previews. pageTitle() is the prompt that would produce the
// page plus the name; each description clears the 120-char mark a SERP snippet
// wants.
const META: Record<string, { title: string; description: string }> = {
    fastfetch: {
        title: personalInfo.seoTitle,
        description: personalInfo.seoDescription,
    },
    whoami: {
        title: pageTitle("whoami"),
        description: `The long version of Milind Madhukar: a developer from Mumbai, ${personalInfo.bio.short.charAt(0).toLowerCase()}${personalInfo.bio.short.slice(1)}`,
    },
    projects: {
        title: pageTitle("ls projects/"),
        description: `Things Milind Madhukar has built, including ${projects
            .filter((p) => p.featured)
            .slice(0, 3)
            .map((p) => p.title.split(" - ")[0])
            .join(", ")}. Side projects, tools, and whatever the current obsession is.`,
    },
};

const meta = META[state.key];
---

<TerminalPage
    initialKey={state.key}
    title={meta.title}
    description={meta.description}
/>
