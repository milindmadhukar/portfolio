---
import Layout from "../layouts/Layout.astro";
import { fetchGithubStats } from "../lib/github";
import { formatTimeAgo } from "../lib/date";
import TerminalPrompt from "../components/TerminalPrompt.astro";
import TerminalCommand from "../components/TerminalCommand.astro";
import DesktopTerminal from "../components/DesktopTerminal.astro";
import MobileTerminal from "../components/MobileTerminal.astro";
import DiscordStatus from "../components/DiscordStatus";
import SocialIcons from "../components/SocialIcons.astro";
import { personalInfo, experience, education } from "../lib/constants";

import {
	SOCIAL_CONFIG,
	TERMINAL_CONFIG,
	DISCORD_ID,
} from "../lib/constants";
import { getBlogPosts } from "../lib/blog";

export const prerender = false;

const githubStats = await fetchGithubStats();
const posts = getBlogPosts();
const latestPost = posts.length > 0 ? posts[0] : null;
---

<Layout includePadding={false}>
	<!-- Mobile Terminal -->
	<div class="block lg:hidden pt-12 p-8">
		<MobileTerminal />
	</div>

	<!-- Desktop Terminal -->
	<div class="hidden lg:block">
		<DesktopTerminal />
	</div>

	<script>
		// Shares formatUptime with the server-rendered SSH banner, so the two
		// surfaces can't drift apart on the format or the arithmetic.
		import { BIRTH_DATE } from "../lib/constants";
		import { formatUptime } from "../lib/utils";

		function updateUptime() {
			const uptime = formatUptime(new Date(BIRTH_DATE));
			document.querySelectorAll(".uptime").forEach((el) => {
				el.textContent = uptime;
			});
		}

		// Tick every second so the elapsed-seconds counter stays live.
		setInterval(updateUptime, 1000);
		updateUptime();
	</script>
</Layout>

<style>
	@media (min-width: 1024px) {
		body {
			overflow: hidden; /* Let the DesktopTerminal container handle scrolling */
		}
	}
</style>
