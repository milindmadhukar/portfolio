---
import "../styles/global.css";
import { personalInfo } from "../lib/constants";
import ThemeSwitcher from "../components/ThemeSwitcher.tsx";

interface Props {
    title?: string;
    description?: string;
    ogDescription?: string;
    includePadding?: boolean;
    image?: string;
    imageAlt?: string;
    bodyClass?: string;
}

const {
    title = personalInfo.seoTitle,
    description = personalInfo.seoDescription,
    // A page that wrote its own description means it for link previews too —
    // otherwise every blog post shared the site's generic one. Read off props
    // rather than the binding above, which has already taken its default.
    ogDescription = Astro.props.description ?? personalInfo.ogDescription,
    includePadding = true,
    image = `${Astro.site}og.png`,
    // Describes the card, not the page. The title used to stand in here, which
    // stopped making sense once it became a shell prompt.
    imageAlt = personalInfo.ogImageAlt,
    bodyClass = "",
} = Astro.props;

// Structured data for the one entity this whole site is about. A name in the
// title is a string; this is what lets a search engine treat "Milind Madhukar"
// as a person, tie the profiles together, and answer a name query with them.
// Same @id on every page, so it reads as one entity rather than one per URL.
const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${Astro.site}#person`,
    name: personalInfo.name,
    url: String(Astro.site),
    email: `mailto:${personalInfo.email}`,
    jobTitle: "Developer",
    description: personalInfo.ogDescription,
    address: {
        "@type": "PostalAddress",
        addressLocality: "Mumbai",
        addressCountry: "IN",
    },
    // Profile URLs only — the mailto is already the email field above.
    sameAs: personalInfo.social
        .map((s) => s.url)
        .filter((url) => url.startsWith("http")),
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/favicon.ico" type="image/x-icon" />
        <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:image" content={image} />
        <meta property="og:site_name" content={personalInfo.name} />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={Astro.url} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={ogDescription} />
        <meta name="twitter:image" content={image} />
        <meta name="twitter:creator" content="@milind_1504" />
        <meta name="twitter:site" content="@milind_1504" />

        <!-- WhatsApp / Telegram -->
        <meta property="og:image:alt" content={imageAlt} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <!-- Additional SEO -->
        <meta name="author" content={personalInfo.name} />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(personSchema)}
        />
        <meta name="theme-color" content="#8b5cf6" />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <!-- Theme initialization script to prevent FOUC -->
        <script is:inline>
            // Run immediately to prevent flash of unstyled content.
            //
            // Both classes are set explicitly. Catppuccin only publishes its
            // dark values under `@variant dark`, i.e. a prefers-color-scheme
            // media query, so *removing* .latte does not select dark - it falls
            // back to whatever the OS wants. On a light-mode phone that left the
            // toggle flipping the class with no visible effect at all. .mocha is
            // shipped by the same stylesheet and pins dark regardless of the OS.
            (function () {
                const stored = localStorage.getItem("theme");
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                const theme =
                    stored === "latte" || stored === "mocha"
                        ? stored
                        : prefersDark
                          ? "mocha"
                          : "latte";
                const root = document.documentElement;
                root.classList.toggle("latte", theme === "latte");
                root.classList.toggle("mocha", theme === "mocha");
            })();
        </script>
    </head>
    <body
        class={`antialiased min-h-screen bg-ctp-crust text-ctp-text transition-colors duration-300 overflow-x-hidden ${bodyClass}`}
    >
        <ThemeSwitcher client:load />
        <div class={includePadding ? "p-8" : "p-0"}>
            <slot />
        </div>

        <!--
            Theme-aware images.

            Only one variant is ever server-rendered — the dark one, matching the
            default theme. Shipping both and hiding one with CSS meant feed
            readers, reader mode and text browsers all showed the image twice.

            Inline and at the end of <body> on purpose: the theme class is
            already set by the is:inline script in <head> before paint, so
            running as the parser reaches here swaps a latte reader's images
            about as early as is possible without shipping both. A latte reader
            may still catch a frame of the dark variant — that is the accepted
            cost of emitting one image.
        -->
        <script is:inline>
            (function () {
                const root = document.documentElement;

                // In-content diagrams only know their light variant by source
                // filename (the remark plugin runs before Astro hashes asset
                // URLs), so BlogPost.astro injects the resolved map.
                const mapEl = document.getElementById("excalidraw-light-map");
                if (mapEl) {
                    let map = {};
                    try {
                        map = JSON.parse(mapEl.textContent || "{}");
                    } catch {}
                    document
                        .querySelectorAll("img[data-light-key]")
                        .forEach((img) => {
                            const url = map[img.dataset.lightKey];
                            if (!url) return;
                            img.dataset.lightSrc = url;
                            img.dataset.darkSrc = img.getAttribute("src");
                        });
                }

                function apply() {
                    const latte = root.classList.contains("latte");
                    document
                        .querySelectorAll("img[data-light-src]")
                        .forEach((img) => {
                            const next = latte
                                ? img.dataset.lightSrc
                                : img.dataset.darkSrc;
                            if (next && img.getAttribute("src") !== next) {
                                img.setAttribute("src", next);
                            }
                        });
                }

                apply();

                // ThemeSwitcher only toggles the class and emits no event, so
                // watch the attribute rather than coupling to the component.
                new MutationObserver(apply).observe(root, {
                    attributes: true,
                    attributeFilter: ["class"],
                });
            })();
        </script>
    </body>
</html>
